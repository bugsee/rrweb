{
  "name": "@bugsee/rrweb-record",
  "version": "2.1.0",
  "description": "Prebuilt, record-only rrweb bundle (Bugsee hardened) for consumption by @bugsee/rrweb via a git dependency. Built from the bugsee-port branch; replay player tree-shaken out.",
  "license": "MIT",
  "type": "module",
  "main": "./record.js",
  "module": "./record.js",
  "types": "./index.d.ts",
