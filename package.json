      "import": "./record.js",
      "default": "./record.js"
    }
  },
  "files": [
    "record.js",
    "index.d.ts",
    "LICENSE"
  ],
  "peerDependencies": {
    "@rrweb/types": "^2.1.0",
    "rrweb": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "@rrweb/types": { "optional": true },
    "rrweb": { "optional": true }
  }
}
